# ============================================================================
# Arrakis — Environment Configuration (.env.example)
# Copy to .env.local (never commit secrets)
# ============================================================================

# --- Global Mode ---
# Set MOCK=1 to run all endpoints against deterministic seed data without Docker/DB/OpenAI
MOCK=1
# Set USE_DB=1 to persist telemetry, scores, taste vectors & leaderboards in Postgres
# (needs `docker compose -f infra/docker-compose.yml up -d postgres` + `npm run seed:db`).
# NOTE: Next.js loads env from apps/web/.env.local — copy this file there too.
USE_DB=0
NODE_ENV=development

# --- Active Demo Persona (used in header/persona switcher) ---
NEXT_PUBLIC_DEFAULT_USER_ID=usr_ritam

# --- Database & Cache (infra/docker-compose.yml defaults) ---
DATABASE_URL=postgresql://arrakis:arrakis_dev@localhost:5432/arrakis
REDIS_URL=redis://localhost:6379

# --- Service Ports & Internal URLs ---
WEB_PORT=3000
RECOMMENDER_PORT=4001
SANDBOX_PORT=4002
SCORING_PORT=4003

NEXT_PUBLIC_RECOMMENDER_URL=http://localhost:4001
NEXT_PUBLIC_SANDBOX_URL=http://localhost:4002
NEXT_PUBLIC_SCORING_URL=http://localhost:4003

# --- Sandbox Orchestrator (Dev B — Srinjoy) ---
# docker | mock
SANDBOX_DRIVER=mock
DOCKER_SOCKET=/var/run/docker.sock
SANDBOX_NETWORK=arrakis-sandbox
SANDBOX_MAX_CONCURRENT=8
SANDBOX_TTL_SEC=60
SANDBOX_IDLE_SEC=20
SANDBOX_MEM_LIMIT=256m
SANDBOX_CPU_LIMIT=0.5

# --- AI Indexing & Embeddings (Optional — falls back to seeded vectors/heuristics) ---
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
WHISPER_MODEL=whisper-1
