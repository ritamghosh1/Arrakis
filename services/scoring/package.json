{
  "name": "@arrakis/scoring",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "start": "node --experimental-strip-types src/index.ts",
    "test": "node --test --experimental-strip-types src/scoring.test.ts",
    "rebuild-from-events": "node --experimental-strip-types -e \"import('./src/engine.ts').then(m => console.log('[scoring:rebuild]', m.defaultScoringLedger.rebuildFromEvents()))\"",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@arrakis/contracts": "*"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "typescript": "^5.5.4"
  }
}
